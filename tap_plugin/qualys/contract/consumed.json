{
  "description": "The elements of Qualys's outputs this plugin reads (req-qualys-contract-extract). The extract is reduced from the committed DTDs to exactly these; a name here that the DTD does not declare fails the build. Element names are unique within each document in the committed DTDs, so the extract is keyed by name.",
  "documents": {
    "detection": {
      "description": "Host List VM Detection Output (host detection API 6.0), from tests/vendor/hld-output.dtd.",
      "dtd": "hld-output.dtd",
      "root": "HOST_LIST_VM_DETECTION_OUTPUT",
      "elements": [
        "HOST_LIST_VM_DETECTION_OUTPUT",
        "RESPONSE",
        "DATETIME",
        "HOST_LIST",
        "HOST",
        "ID",
        "ASSET_ID",
        "IP",
        "IPV6",
        "TRACKING_METHOD",
        "OS",
        "DNS",
        "CLOUD_PROVIDER",
        "CLOUD_SERVICE",
        "CLOUD_RESOURCE_ID",
        "EC2_INSTANCE_ID",
        "NETBIOS",
        "LAST_SCAN_DATETIME",
        "LAST_VM_SCANNED_DATE",
        "LAST_VM_AUTH_SCANNED_DATE",
        "METADATA",
        "EC2",
        "ATTRIBUTE",
        "NAME",
        "VALUE",
        "LAST_STATUS",
        "DETECTION_LIST",
        "DETECTION",
        "UNIQUE_VULN_ID",
        "QID",
        "TYPE",
        "SEVERITY",
        "PORT",
        "PROTOCOL",
        "FQDN",
        "SSL",
        "RESULTS",
        "STATUS",
        "FIRST_FOUND_DATETIME",
        "LAST_FOUND_DATETIME",
        "QDS",
        "QDS_FACTORS",
        "QDS_FACTOR",
        "TIMES_FOUND",
        "LAST_TEST_DATETIME",
        "LAST_UPDATE_DATETIME",
        "LAST_FIXED_DATETIME",
        "LAST_REOPENED_DATETIME",
        "TIMES_REOPENED",
        "IS_IGNORED",
        "IS_DISABLED",
        "LAST_PROCESSED_DATETIME",
        "WARNING",
        "CODE",
        "TEXT",
        "URL"
      ],
      "named_not_declared": {
        "ASSET_ID": "HOST's content model names ASSET_ID? (returned with show_asset_id=1) but the published reference declares no ELEMENT for it; read as text."
      }
    },
    "knowledgebase": {
      "description": "KnowledgeBase VULN List Output (knowledge base API 4.0), from tests/vendor/kb-output.dtd.",
      "dtd": "kb-output.dtd",
      "root": "KNOWLEDGE_BASE_VULN_LIST_OUTPUT",
      "elements": [
        "KNOWLEDGE_BASE_VULN_LIST_OUTPUT",
        "RESPONSE",
        "DATETIME",
        "VULN_LIST",
        "VULN",
        "QID",
        "VULN_TYPE",
        "SEVERITY_LEVEL",
        "TITLE",
        "CATEGORY",
        "LAST_SERVICE_MODIFICATION_DATETIME",
        "PUBLISHED_DATETIME",
        "PATCHABLE",
        "VENDOR_REFERENCE_LIST",
        "VENDOR_REFERENCE",
        "CVE_LIST",
        "CVE",
        "ID",
        "URL",
        "CVSS",
        "CVSS_V3",
        "BASE",
        "TEMPORAL",
        "VECTOR_STRING",
        "WARNING",
        "CODE",
        "TEXT"
      ]
    }
  }
}
